<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.somepro</groupId>
    <artifactId>some-pro</artifactId>
    <version>1.0.0</version>
    <name>some-pro</name>
    <description>纯净脚手架：Spring Boot 3 WebFlux 响应式 + Spring Security + MyBatis-Plus(阻塞 JDBC 桥接响应式) + PageHelper + 响应式 Redis</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <!-- pagehelper 本体版本（不是 starter 版本） -->
        <pagehelper.version>6.1.0</pagehelper.version>
        <lombok.version>1.18.38</lombok.version>
        <hutool.version>5.8.37</hutool.version>
        <!-- 验收测试门禁默认关闭；验收/CI 时用 -Dsurefire.skip=false 打开 -->
        <surefire.skip>true</surefire.skip>
    </properties>

    <dependencies>
        <!-- 响应式 Web 层（替换原 blocking 的 spring-boot-starter-web） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- 响应式 Spring Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- ============ 持久层：MyBatis-Plus + PageHelper（阻塞 JDBC，桥接到响应式） ============ -->

        <!-- MyBatis-Plus（Spring Boot 3 专用 starter，内部已含 spring-boot-starter-jdbc / HikariCP） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- PageHelper 分页。
             用 pagehelper 本体而不是 pagehelper-spring-boot-starter：
             starter 会传递依赖 mybatis-spring-boot-starter（Spring Boot 2 体系），且其自动配置类
             硬引用 org.mybatis.spring.boot.autoconfigure.MybatisAutoConfiguration，
             一旦排除就会在启动时 ClassNotFoundException；不排除又会和 MyBatis-Plus 抢 SqlSessionFactory。
             正确做法：只引入 pagehelper，由 MybatisPlusConfig 手动把 PageInterceptor 注册成 Interceptor bean，
             MyBatis-Plus 的自动装配会通过 setPlugins(...) 把它挂到插件链上。 -->
        <dependency>
            <groupId>com.github.pagehelper</groupId>
            <artifactId>pagehelper</artifactId>
            <version>${pagehelper.version}</version>
        </dependency>

        <!-- JDBC 驱动（MyBatis-Plus 走阻塞 JDBC，需显式引入驱动） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 响应式 Redis（Lettuce，提供 ReactiveRedisTemplate） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 参数校验（WebFlux 下为 WebExchangeBindException） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool.version}</version>
        </dependency>
        <!-- 测试：reactor-test / WebTestClient / spring-security-test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 覆盖父工程继承的 3.13.0：其 plexus-compiler-javac 在 JDK 17 上以进程内方式编译时会反射 javac 内部字段失败
                 （"Cannot load from object array because this.hashes is null"）。3.14.0 已修复该 bug。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- 验收测试门禁：默认跳过测试，CI / 验收时显式开启 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>${surefire.skip}</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
